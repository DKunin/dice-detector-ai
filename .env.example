OPENAI_API_KEY=
SOCKS5_PROXY=socks5h://user:password@proxy.example:1080

PHOTOKUN_DATABASE_PATH=/photokun-data/photokun.sqlite
THUMBNAIL_ROOT=/photokun-thumbnails
STATE_DATABASE_PATH=/data/dice-detector-ai.sqlite
STATUS_PATH=/data/status.json
TARGET_AUTH_SUBJECT=
LIBRARY_ROOT=/dkuninphotos

OPENAI_MODEL=gpt-6-luna
DICE_PROBABILITY_THRESHOLD=0.94
LOOKALIKE_PROBABILITY_MAX=0.10
POSITIVE_CONFIRMATIONS=2
CONCURRENCY=4
POLL_INTERVAL_MS=60000
REQUEST_TIMEOUT_MS=60000
MAX_RETRIES=4
RUN_ONCE=false
DRY_RUN=false
SCAN_LIMIT=0
ENTRY_IDS=
